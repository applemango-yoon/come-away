{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "/api/analyze.py"
    },
    {
      "src": "/api/log",
      "dest": "/api/log.py"
    },
    {
      "src": "/api/edit",
      "dest": "/api/edit.py"
    },
    {
      "src": "/api/delete",
      "dest": "/api/delete.py"
    },
    {
      "src": "/api/member",
      "dest": "/api/member.py"
    },
    {
      "src": "/api/react",
      "dest": "/api/react.py"
    },
    {
      "src": "/api/shell",
      "dest": "/api/shell.py"
    },
    {
      "src": "/api/comment",
      "dest": "/api/comment.py"
    },
    {
      "src": "/api/announce",
      "dest": "/api/announce.py"
    },
    {
      "src": "/api/backup",
      "dest": "/api/backup.py"
    },
    {
      "src": "/api/remind",
      "dest": "/api/remind.py"
    },
    {
      "src": "/api/push",
      "dest": "/api/push.py"
    },
    {
      "src": "/join",
      "dest": "/public/join.html"
    },
    {
      "src": "/join.html",
      "dest": "/public/join.html"
    },
    {
      "src": "/guide",
      "dest": "/public/guide.html"
    },
    {
      "src": "/guide.html",
      "dest": "/public/guide.html"
    },
    {
      "src": "/(icon-180\\.png|icon-192\\.png|icon-512\\.png|manifest\\.json|sw\\.js|robots\\.txt|sitemap\\.xml)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}